# Supabase Edge Functions (İyzico Pazaryeri Ortam Değişkenleri)
# Yerel test veya `supabase secrets set --env-file supabase/functions/.env` için kullanın.

IYZICO_API_KEY=sandbox-your-api-key
IYZICO_SECRET_KEY=sandbox-your-secret-key
# Sandbox: https://sandbox-api.iyzipay.com | Production: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Gerçek canlı ortamda false tutulmalıdır
IYZICO_ALLOW_MOCK=false
# Post-Auth sonrası alt üye işyeri kalem onayını otomatik tetikler
IYZICO_AUTO_APPROVE_ITEMS=true
